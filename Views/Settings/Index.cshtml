@using Microsoft.AspNetCore.Localization
@{
    Layout = "_Layout";
    ViewData["Title"] = "Settings";
    var culture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.Name ?? "ar";
    var isAr = culture.StartsWith("ar");
}
<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="fas fa-cog me-2"></i>@(isAr ? "الإعدادات" : "Settings")</h5>
    </div>
    <div class="card-body text-center py-5 text-muted">
        <i class="fas fa-tools fa-3x mb-3 opacity-50"></i>
        <p class="fs-5">@(isAr ? "هذه الصفحة قيد التطوير" : "This page is under development")</p>
    </div>
</div>
