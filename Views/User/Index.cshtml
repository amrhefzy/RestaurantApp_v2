@using Microsoft.AspNetCore.Localization
@model IEnumerable<RestaurantMS.Models.Domain.ApplicationUser>
@{
    Layout = "_Layout";
    ViewData["Title"] = "User Management";
    var culture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.Name ?? "ar";
    var isAr = culture.StartsWith("ar");
}
<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="fas fa-users me-2"></i>@(isAr ? "إدارة المستخدمين" : "User Management")</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover" id="users-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@(isAr ? "اسم المستخدم" : "Username")</th>
                        <th>@(isAr ? "الاسم" : "Name")</th>
                        <th>@(isAr ? "البريد الإلكتروني" : "Email")</th>
                        <th>@(isAr ? "الحالة" : "Status")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.Id</td>
                            <td>@user.UserName</td>
                            <td>@(isAr ? user.FullNameAr : user.FullNameEn)</td>
                            <td>@user.Email</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">@(isAr ? "نشط" : "Active")</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@(isAr ? "معطل" : "Inactive")</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
