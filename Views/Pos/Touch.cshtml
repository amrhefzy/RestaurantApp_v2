@using Microsoft.AspNetCore.Localization
@{
    var culture = Context.Features.Get<IRequestCultureFeature>()
                      ?.RequestCulture.Culture.Name ?? "ar";
    var isAr    = culture.StartsWith("ar");

    Layout            = "~/Views/Shared/_LayoutTouch.cshtml";
    ViewData["Title"] = isAr ? "POS لمس" : "POS Touch";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pos-touch.css" asp-append-version="true" />
}

<div class="pos-touch-body" id="touchApp">

    @* ── Top Bar ─────────────────────────────────────────────────────── *@
    <div class="touch-topbar">
        <h1><i class="fas fa-cash-register me-2"></i>@(isAr ? "نقطة البيع" : "POS")</h1>
        <span id="touch-order-num" class="badge bg-secondary fs-6">
            @(isAr ? "طلب جديد" : "New Order")
        </span>
        <button class="touch-btn btn btn-outline-light btn-sm" id="touch-held-btn"
                style="min-height:44px;min-width:44px" title="@(isAr ? "معلق" : "Held")">
            <i class="fas fa-pause-circle"></i>
            <span class="badge bg-danger ms-1" id="touch-held-count" style="display:none">0</span>
        </button>
        <button class="touch-btn btn btn-outline-danger btn-sm"
                style="min-height:44px;min-width:44px"
                onclick="document.exitFullscreen && document.exitFullscreen()"
                title="@(isAr ? "الخروج من ملء الشاشة" : "Exit Fullscreen")">
            <i class="fas fa-compress"></i>
        </button>
    </div>

    @* ── Main area ────────────────────────────────────────────────────── *@
    <div class="touch-wrapper">

        @* LEFT — Menu ─────────────────────────────────────────────────── *@
        <div class="touch-menu-side">

            @* Search *@
            <div class="touch-search">
                <input type="text" id="touch-search" autocomplete="off"
                       placeholder="@(isAr ? "ابحث..." : "Search...")" />
            </div>

            @* Category tabs *@
            <div class="touch-category-bar" id="touch-cat-bar">
                <button class="touch-cat-tab active" data-id="">
                    <i class="fas fa-border-all"></i>
                    @(isAr ? "الكل" : "All")
                </button>
            </div>

            @* Menu grid *@
            <div class="touch-menu-scroll">
                <div class="touch-menu-grid" id="touch-menu-grid">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="touch-item-card" style="background:rgba(255,255,255,0.04)"></div>
                    }
                </div>
            </div>
        </div>

        @* RIGHT — Cart ─────────────────────────────────────────────────── *@
        <div class="touch-cart-side">

            @* Cart header *@
            <div class="touch-cart-header">
                <span><i class="fas fa-receipt me-2"></i>@(isAr ? "الطلب" : "Order")</span>
                <span id="touch-item-count" class="badge bg-primary">0</span>
            </div>

            @* Order meta *@
            <div class="touch-order-meta">
                <select id="touch-order-type">
                    <option value="1">@(isAr ? "داخل" : "Dine In")</option>
                    <option value="2">@(isAr ? "تيك أواي" : "Takeaway")</option>
                    <option value="3">@(isAr ? "توصيل" : "Delivery")</option>
                </select>
                <input type="text" id="touch-table-num"
                       placeholder="@(isAr ? "طاولة" : "Table")" maxlength="10" />
            </div>

            @* Cart items *@
            <div class="touch-cart-items" id="touch-cart-items">
                <div class="text-center py-5 text-white-50" id="touch-cart-empty">
                    <i class="fas fa-shopping-cart fa-2x mb-2 d-block"></i>
                    @(isAr ? "السلة فارغة" : "Cart is empty")
                </div>
            </div>

            @* Totals *@
            <div class="touch-totals">
                <div class="touch-totals-row">
                    <span>@(isAr ? "مجموع" : "Subtotal")</span>
                    <span id="touch-subtotal">0.000</span>
                </div>
                <div class="touch-totals-row">
                    <span>@(isAr ? "ضريبة 14%" : "Tax 14%")</span>
                    <span id="touch-tax">0.000</span>
                </div>
                <div class="touch-totals-row">
                    <span>@(isAr ? "خصم" : "Discount")</span>
                    <span id="touch-discount">0.000</span>
                </div>
                <div class="touch-totals-row grand">
                    <span>@(isAr ? "الإجمالي" : "Total")</span>
                    <span id="touch-total">0.000</span>
                </div>
            </div>

            @* Payment buttons *@
            <div class="touch-payment-btns">
                <button class="touch-pay-btn" id="touch-cash-btn"
                        style="background:var(--success-color);color:#fff;">
                    <i class="fas fa-money-bill-wave fa-lg"></i>
                    @(isAr ? "نقداً" : "CASH")
                </button>
                <button class="touch-pay-btn" id="touch-card-btn"
                        style="background:var(--secondary-color);color:#fff;">
                    <i class="fas fa-credit-card fa-lg"></i>
                    @(isAr ? "بطاقة" : "CARD")
                </button>
                <button class="touch-pay-btn" id="touch-split-btn"
                        style="background:var(--warning-color);color:#fff;">
                    <i class="fas fa-code-branch fa-lg"></i>
                    @(isAr ? "تقسيم" : "SPLIT")
                </button>
            </div>

            @* Action buttons row *@
            <div style="display:flex;gap:8px;padding:0 12px 12px">
                <button class="touch-btn btn btn-outline-danger flex-fill" id="touch-clear-btn"
                        style="min-height:48px">
                    <i class="fas fa-trash-alt"></i>
                </button>
                <button class="touch-btn btn btn-outline-warning flex-fill" id="touch-hold-btn"
                        style="min-height:48px">
                    <i class="fas fa-pause"></i>
                </button>
                <button class="touch-btn btn btn-outline-secondary flex-fill" id="touch-void-btn"
                        style="min-height:48px">
                    <i class="fas fa-ban"></i>
                </button>
            </div>

        </div>
    </div>
</div>

@* Numpad overlay (shared between qty and cash) *@
<div class="numpad-overlay" id="numpadOverlay" style="display:none">
    <div class="numpad-sheet">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0 text-white" id="numpad-title">
                @(isAr ? "أدخل الكمية" : "Enter Quantity")
            </h5>
            <button class="btn btn-sm btn-outline-light" id="numpad-close">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="numpad-display" id="numpad-display">1</div>
        <div class="numpad-grid">
            @foreach (var k in new[] {"7","8","9","4","5","6","1","2","3"})
            {
                <button class="numpad-btn" data-k="@k">@k</button>
            }
            <button class="numpad-btn clear-btn" data-k="clear">C</button>
            <button class="numpad-btn" data-k="0">0</button>
            <button class="numpad-btn" data-k="back"><i class="fas fa-backspace"></i></button>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button class="numpad-btn confirm-btn flex-fill" id="numpad-confirm" style="height:60px">
                <i class="fas fa-check me-2"></i>@(isAr ? "تأكيد" : "OK")
            </button>
        </div>
        @* Quick cash shortcuts (shown only in cash mode) *@
        <div id="cash-quick-btns" class="quick-cash-grid mt-3" style="display:none;
             display:grid;grid-template-columns:repeat(4,1fr);gap:8px">
            @foreach (var amt in new[] {"50","100","200","500"})
            {
                <button class="numpad-btn" style="height:50px;font-size:15px"
                        data-quick="@amt">@amt</button>
            }
        </div>
    </div>
</div>

@* Modifier popup *@
<div class="modifier-popup" id="modifierPopup" style="display:none">
    <div class="modifier-sheet">
        <h5 id="modifier-title">Options</h5>
        <div class="mb-3">
            <label class="form-label text-white-50 small">
                @(isAr ? "ملاحظات" : "Notes")
            </label>
            <textarea id="modifier-notes" rows="3"
                      placeholder="@(isAr ? "أي طلبات خاصة؟" : "Special requests?")"></textarea>
        </div>
        <div class="d-flex gap-2">
            <button class="touch-btn btn btn-secondary flex-fill" id="modifier-cancel"
                    style="min-height:50px">
                @(isAr ? "إلغاء" : "Cancel")
            </button>
            <button class="touch-btn btn btn-success flex-fill" id="modifier-confirm"
                    style="min-height:50px">
                @(isAr ? "إضافة" : "Add to Cart")
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/modules/pos-touch.js" asp-append-version="true"></script>
}
