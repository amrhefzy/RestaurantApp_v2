@using Microsoft.AspNetCore.Localization
@{
    var culture = Context.Features.Get<IRequestCultureFeature>()
                      ?.RequestCulture.Culture.Name ?? "ar";
    var isAr    = culture.StartsWith("ar");

    Layout                  = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"]       = isAr ? "التقارير" : "Reports";
    ViewData["ActiveMenu"]  = "Reports";
    ViewData["Breadcrumbs"] = new List<(string Label, string? Url)>
    {
        (isAr ? "الرئيسية" : "Home",  "/"),
        (isAr ? "التقارير" : "Reports", null)
    };

    string fromVal = ViewBag.From ?? DateTime.UtcNow.AddDays(-30).ToString("yyyy-MM-dd");
    string toVal   = ViewBag.To   ?? DateTime.UtcNow.ToString("yyyy-MM-dd");
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <style>
        .metric-card        { border-left: 4px solid; }
        .metric-card.sales  { border-color: var(--primary-color); }
        .metric-card.orders { border-color: var(--success-color); }
        .metric-card.avg    { border-color: var(--warning-color); }
        .metric-card.tax    { border-color: var(--danger-color); }
        .metric-value       { font-size: 1.8rem; font-weight: 700; }
        .chart-box          { position: relative; min-height: 260px; }
    </style>
}

@* ── Header: date filter + export buttons ─────────────────────────────────── *@
<div class="d-flex flex-wrap gap-2 align-items-center mb-4">
    <h4 class="mb-0 me-auto fw-bold">
        <i class="fas fa-chart-bar me-2"></i>
        @(isAr ? "لوحة التقارير" : "Reports Dashboard")
    </h4>
    <input type="text" id="filterFrom" class="form-control form-control-sm" style="width:130px" value="@fromVal" />
    <span>→</span>
    <input type="text" id="filterTo"   class="form-control form-control-sm" style="width:130px" value="@toVal" />
    <button class="btn btn-primary btn-sm" id="applyFilter">
        <i class="fas fa-sync-alt"></i>
    </button>
    <div class="vr"></div>
    <a href="/Report/ZReport?date=@DateTime.UtcNow.ToString("yyyy-MM-dd")" target="_blank"
       class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-print me-1"></i>Z
    </a>
    <a href="/Report/XReport" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-camera me-1"></i>X
    </a>
    <button class="btn btn-outline-success btn-sm" id="exportExcelBtn">
        <i class="fas fa-file-excel me-1"></i>@(isAr ? "إكسل" : "Excel")
    </button>
</div>

@* ── Metric cards ──────────────────────────────────────────────────────────── *@
<div class="row g-3 mb-4">
    @{
        void MetricCard(string id, string icon, string label, string cls) {
            <div class="col-sm-6 col-xl-3">
                <div class="card metric-card @cls shadow-sm">
                    <div class="card-body d-flex align-items-center gap-3">
                        <i class="fas @icon fa-2x text-secondary opacity-50"></i>
                        <div>
                            <div class="text-muted small">@label</div>
                            <div class="metric-value" id="@id">—</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    @{ MetricCard("metricSales",  "fa-coins",            isAr ? "إجمالي المبيعات" : "Total Sales",   "sales"); }
    @{ MetricCard("metricOrders", "fa-receipt",          isAr ? "عدد الطلبات"    : "Order Count",    "orders"); }
    @{ MetricCard("metricAvg",    "fa-calculator",       isAr ? "متوسط الطلب"    : "Avg Order",      "avg"); }
    @{ MetricCard("metricTax",    "fa-percentage",       isAr ? "ضريبة محصلة"    : "Tax Collected",  "tax"); }
</div>

@* ── Charts row ────────────────────────────────────────────────────────────── *@
<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-bold">
                <i class="fas fa-chart-bar me-2"></i>
                @(isAr ? "المبيعات حسب الفئة" : "Sales by Category")
            </div>
            <div class="card-body chart-box">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-bold">
                <i class="fas fa-chart-line me-2"></i>
                @(isAr ? "الاتجاه اليومي" : "Daily Trend")
            </div>
            <div class="card-body chart-box">
                <canvas id="trendChart"></canvas>
            </div>
        </div>
    </div>
</div>

@* ── Hourly heatmap ─────────────────────────────────────────────────────────── *@
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">
                <i class="fas fa-th me-2"></i>
                @(isAr ? "الطلبات بالساعة" : "Hourly Sales Heatmap")
            </div>
            <div class="card-body chart-box">
                <canvas id="heatmapChart"></canvas>
            </div>
        </div>
    </div>
</div>

@* ── Best sellers table ─────────────────────────────────────────────────────── *@
<div class="card shadow-sm">
    <div class="card-header fw-bold">
        <i class="fas fa-trophy me-2"></i>
        @(isAr ? "أكثر 10 أصناف مبيعاً" : "Top 10 Best Sellers")
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>@(isAr ? "الصنف" : "Item")</th>
                        <th>@(isAr ? "الكمية" : "Qty")</th>
                        <th>@(isAr ? "الإيراد" : "Revenue")</th>
                        <th>@(isAr ? "الطلبات" : "Orders")</th>
                    </tr>
                </thead>
                <tbody id="bestSellersTbody">
                    <tr><td colspan="5" class="text-center text-muted py-3">
                        <i class="fas fa-spinner fa-spin me-2"></i>
                        @(isAr ? "جاري التحميل..." : "Loading...")
                    </td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="~/js/modules/reports.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            flatpickr('#filterFrom', { dateFormat: 'Y-m-d' });
            flatpickr('#filterTo',   { dateFormat: 'Y-m-d' });

            ReportsModule.initDashboard(
                document.getElementById('filterFrom').value,
                document.getElementById('filterTo').value,
                @(isAr ? "true" : "false")
            );

            document.getElementById('applyFilter').addEventListener('click', () => {
                ReportsModule.initDashboard(
                    document.getElementById('filterFrom').value,
                    document.getElementById('filterTo').value,
                    @(isAr ? "true" : "false")
                );
            });

            document.getElementById('exportExcelBtn').addEventListener('click', () => {
                ReportsModule.exportExcel(document.getElementById('filterTo').value);
            });
        });
    </script>
}
