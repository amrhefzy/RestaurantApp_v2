@using Microsoft.AspNetCore.Localization
@{
    var culture = Context.Features.Get<IRequestCultureFeature>()
                      ?.RequestCulture.Culture.Name ?? "ar";
    var isAr    = culture.StartsWith("ar");

    Layout                  = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"]       = isAr ? "تقرير الوردية الحالية (X)" : "X-Report (Current Shift)";
    ViewData["ActiveMenu"]  = "Reports";

    var r = ViewBag.Report as RestaurantMS.Models.DTOs.XReportDto;
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">
                    <i class="fas fa-camera me-2"></i>
                    @(isAr ? "لقطة الوردية (X)" : "X-Report — Shift Snapshot")
                </span>
                <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                    <i class="fas fa-print me-1"></i>@(isAr ? "طباعة" : "Print")
                </button>
            </div>
            <div class="card-body">
                @if (r is null)
                {
                    <div class="alert alert-warning">
                        @(isAr ? "لا توجد بيانات متاحة." : "No data available.")
                    </div>
                }
                else
                {
                    void Row(string lbl, string val, bool bold = false) {
                        <div class="d-flex justify-content-between py-2 border-bottom @(bold ? "fw-bold fs-5" : "")">
                            <span class="@(bold ? "" : "text-muted")">@lbl</span>
                            <span>@val</span>
                        </div>
                    }
                    Row(isAr ? "الفترة من" : "From",         r.From.ToString("dd MMM yyyy HH:mm"));
                    Row(isAr ? "الفترة إلى" : "To",           r.To.ToString("dd MMM yyyy HH:mm"));
                    Row(isAr ? "عدد الطلبات" : "Orders",       r.TotalOrders.ToString());
                    Row(isAr ? "الإجمالي قبل الضريبة" : "Subtotal", r.SubTotal.ToString("N3"));
                    Row(isAr ? "الضريبة" : "Tax",              r.TaxAmount.ToString("N3"));
                    Row(isAr ? "المبيعات النقدية" : "Cash",    r.CashTotal.ToString("N3"));
                    Row(isAr ? "مبيعات البطاقة" : "Card",      r.CardTotal.ToString("N3"));
                    Row(isAr ? "الإجمالي" : "Net Sales",        r.NetSales.ToString("N3"), true);

                    @if (r.HourlySales?.Any() == true)
                    {
                        <h6 class="mt-3 mb-2 text-muted">@(isAr ? "توزيع الساعات" : "Hourly Breakdown")</h6>
                        @foreach (var h in r.HourlySales.Where(x => x.OrderCount > 0))
                        {
                            <div class="d-flex justify-content-between py-1 small">
                                <span>@h.Hour.ToString("D2"):00</span>
                                <span>@h.OrderCount @(isAr ? "طلب" : "orders") — @h.TotalAmount.ToString("N3")</span>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    </div>
</div>
