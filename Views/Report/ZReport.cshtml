@using Microsoft.AspNetCore.Localization
@model RestaurantMS.Models.DTOs.ZReportDto
@{
    var culture = Context.Features.Get<IRequestCultureFeature>()
                      ?.RequestCulture.Culture.Name ?? "ar";
    var isAr    = culture.StartsWith("ar");

    Layout = "~/Views/Shared/_LayoutPrint.cshtml";
    ViewData["Title"] = "Z-Report";
}

<style>
    body      { font-family: 'Courier New', monospace; font-size: 12px; color: #000; }
    .z-report { max-width: 380px; margin: 0 auto; padding: 8px; }
    .z-header { text-align: center; border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 10px; }
    .z-row    { display: flex; justify-content: space-between; padding: 2px 0; }
    .z-row.bold { font-weight: 700; font-size: 13px; }
    .z-row.total { border-top: 1px solid #000; padding-top: 4px; margin-top: 4px; font-weight: 700; font-size: 14px; }
    .z-section { margin: 10px 0; border-top: 1px dashed #000; padding-top: 8px; }
    .z-section h4 { font-size: 12px; font-weight: 700; margin-bottom: 6px; text-transform: uppercase; }
    .z-footer { text-align: center; border-top: 2px solid #000; margin-top: 12px; padding-top: 8px; font-size: 11px; }
    .sig-box  { display: flex; justify-content: space-around; margin-top: 24px; }
    .sig-line { border-top: 1px solid #000; width: 140px; text-align: center; padding-top: 4px; font-size: 11px; }
    @@media print { body { margin: 0; } }
</style>

<div class="z-report">

    @* Header *@
    <div class="z-header">
        <div style="font-size:16px;font-weight:700">
            @(isAr ? "تقرير إقفال اليوم (Z)" : "Z-REPORT — END OF DAY")
        </div>
        <div>@Model.Date.ToString("dd MMMM yyyy")</div>
        <div>@(isAr ? "أصدره:" : "Generated by:") @Model.GeneratedBy</div>
        <div>@Model.GeneratedAt.ToString("dd/MM/yyyy HH:mm:ss")</div>
    </div>

    @* Sales summary *@
    <div class="z-section">
        <h4>@(isAr ? "ملخص المبيعات" : "Sales Summary")</h4>
        <div class="z-row"><span>@(isAr ? "عدد الطلبات" : "Total Orders")</span><span>@Model.TotalOrders</span></div>
        <div class="z-row"><span>@(isAr ? "إجمالي قبل الضريبة" : "Subtotal")</span><span>@Model.SubTotal.ToString("N3")</span></div>
        <div class="z-row"><span>@(isAr ? "ضريبة (14%)" : "Tax (14%)")</span><span>@Model.TaxAmount.ToString("N3")</span></div>
        <div class="z-row"><span>@(isAr ? "خصومات" : "Discounts")</span><span>@Model.DiscountAmount.ToString("N3")</span></div>
        <div class="z-row total"><span>@(isAr ? "الإجمالي" : "Net Sales")</span><span>@Model.NetSales.ToString("N3")</span></div>
    </div>

    @* Payment methods *@
    <div class="z-section">
        <h4>@(isAr ? "طرق الدفع" : "Payment Methods")</h4>
        <div class="z-row"><span>@(isAr ? "نقداً" : "Cash")</span><span>@Model.CashTotal.ToString("N3")</span></div>
        <div class="z-row"><span>@(isAr ? "بطاقة" : "Card")</span><span>@Model.CardTotal.ToString("N3")</span></div>
        <div class="z-row bold"><span>@(isAr ? "الإجمالي" : "Total")</span><span>@(Model.CashTotal + Model.CardTotal).ToString("N3")</span></div>
    </div>

    @* Voids & exceptions *@
    <div class="z-section">
        <h4>@(isAr ? "الطلبات الملغية" : "Voids & Exceptions")</h4>
        <div class="z-row"><span>@(isAr ? "ملغية" : "Voided Orders")</span><span>@Model.VoidedOrders</span></div>
    </div>

    @* Top items *@
    @if (Model.TopItems?.Any() == true)
    {
        <div class="z-section">
            <h4>@(isAr ? "أكثر الأصناف مبيعاً" : "Top Selling Items")</h4>
            @foreach (var item in Model.TopItems.Take(5))
            {
                <div class="z-row">
                    <span>@(isAr ? item.NameAr : item.NameEn)</span>
                    <span>@item.TotalQuantity × @item.TotalRevenue.ToString("N3")</span>
                </div>
            }
        </div>
    }

    @* Signatures *@
    <div class="sig-box">
        <div class="sig-line">@(isAr ? "توقيع الكاشير" : "Cashier")</div>
        <div class="sig-line">@(isAr ? "توقيع المدير" : "Manager")</div>
    </div>

    <div class="z-footer">
        @(isAr ? "*** نهاية التقرير ***" : "*** END OF REPORT ***")
        <br />
        @Model.IsClosed ? (isAr ? "مُغلق" : "CLOSED") : (isAr ? "غير مُغلق" : "NOT CLOSED")
    </div>
</div>

@section Scripts {
    <script>window.onload = () => window.print();</script>
}
